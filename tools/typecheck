#!/bin/sh
# Type-check every C# assembly in the project without opening Unity.
#
# Usage (from the repo root):
#   tools/typecheck
#
# Why this exists: a compile error normally costs a domain reload to find, and when Unity is closed
# (or an agent is working remotely) there is no feedback at all. This reuses the .csproj files Unity
# already generates -- same netstandard2.1 target, same reference assemblies, same #defines -- and
# runs Roslyn over them directly. It takes about two seconds and needs no Editor.
#
# What it does NOT do:
#   - It does not run tests. Use Unity's Test Runner, or the bridge's run_tests.
#   - It does not catch anything outside the compiler: missing .meta files, broken scene references,
#     serialized fields that lost their values, or anything that only shows up at runtime.
#   - The .csproj files are generated by Unity, so a file added while Unity was closed is invisible
#     here until Unity next regenerates them. If a new script seems to be ignored, that is why.
#
# Requires the .NET SDK (dotnet on PATH). Unity ships its own reference assemblies, so no NuGet
# restore and no network access are needed.

set -e

root=$(cd "$(dirname "$0")/../.." && pwd)
cd "$root"

# Output paths are left exactly as Unity generated them: Temp/obj and Temp/bin, which is where Rider
# and Visual Studio also build, and which .gitignore already excludes. Do not redirect them to one
# shared directory -- three projects sharing an obj/ path makes MSBuild treat them as the same
# project and report a phantom "circular dependency" on the assembly definition references.
projects=$(ls ./*.csproj 2>/dev/null || true)
if [ -z "$projects" ]; then
    echo "No .csproj files found. Open the project in Unity once so it generates them."
    exit 1
fi

status=0
for project in $projects; do
    name=$(basename "$project" .csproj)
    printf '%-44s' "$name"

    # A generated .csproj can outlive the files it lists: delete the last script in an assembly and
    # Unity stops regenerating that project, leaving it pointing at a file that no longer exists.
    # That is stale tooling, not a code error, so say so and move on instead of reporting a failure.
    missing=$(grep -o 'Compile Include="[^"]*"' "$project" |
        sed 's/Compile Include="//; s/"$//; s|\\|/|g' |
        while IFS= read -r source; do [ -f "$source" ] || echo "$source"; done)
    if [ -n "$missing" ]; then
        echo "skipped (stale project file, lists missing sources)"
        echo "$missing" | sed 's/^/    missing: /'
        continue
    fi

    if log=$(dotnet build "$project" -v:q --nologo 2>&1); then
        echo "ok"
    else
        echo "FAILED"
        echo "$log" | grep -E "error|warning" || echo "$log"
        status=1
    fi
done

exit $status
